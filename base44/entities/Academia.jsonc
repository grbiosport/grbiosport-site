{
  "name": "Academia",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome",
      "description": "Nome da academia parceira"
    },
    "bairro": {
      "type": "string",
      "title": "Bairro",
      "description": "Bairro / regi\u00e3o da academia"
    },
    "cidade": {
      "type": "string",
      "title": "Cidade"
    },
    "plano": {
      "type": "string",
      "enum": [
        "essencial",
        "profissional",
        "black_belt"
      ],
      "title": "Plano",
      "description": "Plano de higieniza\u00e7\u00e3o aderido"
    },
    "selo": {
      "type": "string",
      "title": "Selo",
      "description": "C\u00f3digo do selo de certifica\u00e7\u00e3o GR Biosport"
    },
    "data_adesao": {
      "type": "string",
      "format": "date",
      "title": "Data de ades\u00e3o"
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "title": "Ativo",
      "description": "Se o contrato de higieniza\u00e7\u00e3o est\u00e1 ativo"
    }
  },
  "required": [
    "name"
  ]
}